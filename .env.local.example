# PostalMind AI — environment variables
# Copy to .env.local. The app runs in DEMO mode with none of these set.

# --- AI provider (optional) -------------------------------------------------
# Without a key, /ask shows retrieved sources directly and never composes new
# claims. With a key, answers are model-composed but still constrained to the
# retrieved passages — the model never invents rules, dates or rates.
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# "openrouter/free" lets OpenRouter pick among currently-available free
# models. You can also pin an explicit free variant, e.g. "some-provider/some-model:free" —
# either way, do not treat one temporary free model as a permanent dependency.
OPENROUTER_MODEL=openrouter/free

# OPENROUTER_MODEL_PRIMARY overrides OPENROUTER_MODEL if both are set (same meaning).
# OPENROUTER_MODEL_PRIMARY=openrouter/free

# Optional: a second model the quality gate retries ONCE, only when the primary
# model's response is rejected as unusable for grounded QA (e.g. openrouter/free
# occasionally routes to a model unsuited to citation-based answers, such as a
# content-safety classifier). Leave unset to just degrade straight to the
# deterministic source-only answer in that case — never left to invent a fix.
# OPENROUTER_MODEL_FALLBACK=

# Optional attribution headers OpenRouter uses for free-tier routing/analytics.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PostalMind AI

# Override the API base URL (rarely needed).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App -------------------------------------------------------------------
# development | preview | production  (inferred from VERCEL_ENV / NODE_ENV if unset)
APP_ENV=

# Canonical site URL used for metadata / OpenGraph.
NEXT_PUBLIC_SITE_URL=

# --- Persistence (optional; not wired to a driver yet) --------------------
# Postgres connection string. Absent -> in-memory demo store (not durable).
DATABASE_URL=

# --- Limits & hygiene ----------------------------------------------------
# Max bytes for an evidence upload (default 5 MiB).
MAX_UPLOAD_SIZE=5242880

# Salt for hashing client IPs in logs (set a random value in production).
HASH_SALT=
